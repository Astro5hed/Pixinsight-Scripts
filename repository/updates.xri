<?xml version="1.0" encoding="UTF-8"?>
<xri version="1.0">
   <description>
      <p>AstroShed scripts for PixInsight.</p>
   </description>
   <platform os="all" arch="noarch" version="1.8.9:1.9.99">
      <package fileName="DustLaneEnhancer_1.3.3.zip" sha1="598ebd5570429cf467d6cdf70e0f1cc1d0fa058c" type="script" releaseDate="20261016">
         <title>Dust Lane Enhancer 1.3.3</title>
         <description>
            <p>Deepens dust lanes and dark filaments, found by their shape rather than their brightness. Use it on a stretched, preferably starless, image. After installing, it is under Script &gt; AstroShed &gt; Dust Lane Enhancer.</p>
         </description>
      </package>
      <package fileName="BrightFilamentEnhancer_1.1.2.zip" sha1="18e0f1541d38efe39d093a3bb427242a933c14b7" type="script" releaseDate="20261021">
         <title>Bright Filament Enhancer 1.1.2</title>
         <description>
            <p>Brightens thin bright filaments, found by their shape rather than their brightness. Use it on a stretched, starless image. After installing, it is under Script &gt; AstroShed &gt; Bright Filament Enhancer.</p>
         </description>
      </package>
   </platform>
</xri>
